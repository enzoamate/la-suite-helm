{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstream"],
  "properties": {
    "upstream": {
      "type": "object",
      "additionalProperties": true,
      "required": ["image", "frontend", "yProvider", "yhub", "jwtKeys"],
      "properties": {
        "image": {"type": "object"},
        "frontend": {"type": "object"},
        "yProvider": {"type": "object"},
        "yhub": {"type": "object"},
        "jwtKeys": {
          "type": "object",
          "required": ["enabled", "existingSecret"],
          "properties": {
            "enabled": {"const": true},
            "existingSecret": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
